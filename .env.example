# OpenRouter free-model configuration for the GenAR Version 0 PADER generator.
# Copy this file to .env and fill in your key.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/free
OPENROUTER_TIMEOUT_S=120
OPENROUTER_THINKING=disabled
PROMPTS_DIR=autopader/prompts
